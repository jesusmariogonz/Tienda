# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tienda?schema=public"

# App
# Base URL of the storefront. Set this per-environment (e.g. https://tienda.844digital.com
# or https://your-own-domain.com later) — never hardcode a domain in code.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="Tienda"

# Auth (NextAuth)
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Admin bootstrap (used by prisma/seed.ts to create the single admin user)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_PUBLIC_KEY=""
