# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tienda?schema=public"
# Direct (non-pooled) connection used only for migrations. Locally there's
# no pooler in front of Postgres, so this is the same value as above. In
# Vercel/Neon, set this to the "unpooled" connection string.
DIRECT_URL="postgresql://user:password@localhost:5432/tienda?schema=public"

# App
# Base URL of the storefront. Set this per-environment (e.g. https://tienda.844digital.com
# or https://your-own-domain.com later) — never hardcode a domain in code.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="Tienda"

# Auth (NextAuth)
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Admin bootstrap (used by prisma/seed.ts to create the single admin user)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_PUBLIC_KEY=""

# Email (Resend) — order confirmations and low-stock alerts.
# Without these set, emails are skipped (logged only) rather than failing.
RESEND_API_KEY=""
EMAIL_FROM="Tienda <pedidos@tu-dominio.com>"

# Vercel Blob — required for uploading product images from the admin panel.
# Auto-populated when you connect a Blob store to the project in Vercel.
BLOB_READ_WRITE_TOKEN=""

# Loyverse — keeps the online store's inventory in sync with in-person
# sales made through Loyverse (used as the physical POS). Get the token
# from Back Office → Settings → Access Tokens, and the store ID from
# Settings → Stores. Without both set, /admin/loyverse shows as
# unconfigured and inventory pushes/pulls are skipped.
LOYVERSE_API_TOKEN=""
LOYVERSE_STORE_ID=""

# Skydropx — automatic label generation + tracking for Envíos in the admin
# panel. Uses OAuth2 client credentials (from Skydropx → Conexiones → API).
# Without both set, the "Generar guía con Skydropx" button stays hidden and
# shipments fall back to manual tracking entry.
SKYDROPX_CLIENT_ID=""
SKYDROPX_CLIENT_SECRET=""
SKYDROPX_API_URL="https://pro.skydropx.com/api/v1"
SKYDROPX_AUTH_URL="https://api-pro.skydropx.com/api/v1/oauth/token"
# Default carrier/service used for label generation (carrier_name/service_code
# from GET /api/v1/shipments/carrier_services — must be enabled on your account).
SKYDROPX_CARRIER="dhl"
SKYDROPX_SERVICE="express_ltl"
# Carta Porte fields, required by Mexican shipping regulation — from
# GET /api/v1/shipments/packagings and /api/v1/shipments/consignment_notes.
SKYDROPX_PACKAGE_TYPE="4G"
SKYDROPX_CONSIGNMENT_NOTE="53101602"

# Set to "true" to show a "Compra de prueba" checkout option that marks the
# order paid (and decrements real inventory) without charging any card —
# useful for demos before Stripe/Mercado Pago keys are live. Turn this off
# (remove or set to anything else) before accepting real payments.
NEXT_PUBLIC_DEMO_CHECKOUT="false"
