// Prisma schema for the store: products, variants, inventory, sales (online + POS), admin.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection — pgbouncer's
  // transaction pooling mode doesn't support the advisory locks
  // `prisma migrate` relies on. Falls back to DATABASE_URL locally where
  // there's no pooler in front of Postgres.
  directUrl = env("DIRECT_URL")
}

// ---------- Auth / Admin ----------

enum UserRole {
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posSales          PosSale[]
  inventoryMovements InventoryMovement[]
}

// ---------- Catalog ----------

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  basePrice   Decimal  @db.Decimal(10, 2)
  active      Boolean  @default(true)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images   ProductImage[]
  variants ProductVariant[]

  @@index([categoryId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  size      String
  color     String
  colorHex  String? // hex swatch shown on the storefront instead of the color name
  price     Decimal? @db.Decimal(10, 2) // overrides Product.basePrice when set
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory           Inventory?
  inventoryMovements  InventoryMovement[]
  orderItems          OrderItem[]
  posSaleItems        PosSaleItem[]

  @@unique([productId, size, color])
  @@index([productId])
}

// ---------- Inventory ----------

model Inventory {
  id                String         @id @default(cuid())
  variantId         String         @unique
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int            @default(0)
  lowStockThreshold Int            @default(5)
  // Set when a low-stock alert email has been sent for the current dip
  // below threshold; cleared once restocked above it, so restocking is
  // the only thing that re-arms the alert (no repeat emails per sale).
  lowStockAlertedAt DateTime?
  updatedAt         DateTime       @updatedAt
}

enum InventoryMovementType {
  RESTOCK
  ONLINE_SALE
  POS_SALE
  ADJUSTMENT
  RETURN
}

model InventoryMovement {
  id         String                 @id @default(cuid())
  variantId  String
  variant    ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type       InventoryMovementType
  quantity   Int                    // positive = stock in, negative = stock out
  note       String?
  userId     String?
  user       User?                  @relation(fields: [userId], references: [id])
  orderId    String?
  order      Order?                 @relation(fields: [orderId], references: [id])
  posSaleId  String?
  posSale    PosSale?               @relation(fields: [posSaleId], references: [id])
  createdAt  DateTime               @default(now())

  @@index([variantId])
  @@index([createdAt])
}

// ---------- Online Orders / Payments ----------

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  MERCADO_PAGO
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)
  active         Boolean    @default(true)
  minOrderAmount Decimal?   @db.Decimal(10, 2)
  usageLimit     Int?
  usedCount      Int        @default(0)
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  orders Order[]
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  status          OrderStatus     @default(PENDING)
  customerEmail   String
  customerName    String?
  customerPhone   String?
  shippingAddress Json?
  subtotal        Decimal         @db.Decimal(10, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(10, 2)
  shippingCost    Decimal         @default(0) @db.Decimal(10, 2)
  total           Decimal         @db.Decimal(10, 2)
  currency        String          @default("MXN")
  paymentProvider PaymentProvider?
  paymentRef      String?
  couponId        String?
  coupon          Coupon?         @relation(fields: [couponId], references: [id])
  confirmationSentAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items               OrderItem[]
  inventoryMovements  InventoryMovement[]
  shipment            Shipment?

  @@index([status])
  @@index([createdAt])
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         ShipmentStatus @default(PENDING)
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  labelUrl       String?
  cost           Decimal?       @db.Decimal(10, 2)
  notes          String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)

  @@index([orderId])
  @@index([variantId])
}

// ---------- POS (in-store, record-only) ----------

model PosSale {
  id        String   @id @default(cuid())
  saleNumber String  @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  total     Decimal  @db.Decimal(10, 2)
  note      String?
  createdAt DateTime @default(now())

  items               PosSaleItem[]
  inventoryMovements  InventoryMovement[]

  @@index([createdAt])
}

model PosSaleItem {
  id        String         @id @default(cuid())
  posSaleId String
  posSale   PosSale        @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)

  @@index([posSaleId])
  @@index([variantId])
}
