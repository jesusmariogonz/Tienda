// Prisma schema for the store: products, variants, inventory, sales (online + POS), admin.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection — pgbouncer's
  // transaction pooling mode doesn't support the advisory locks
  // `prisma migrate` relies on. Falls back to DATABASE_URL locally where
  // there's no pooler in front of Postgres.
  directUrl = env("DIRECT_URL")
}

// ---------- Auth / Admin ----------

enum UserRole {
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posSales          PosSale[]
  inventoryMovements InventoryMovement[]
}

// ---------- Catalog ----------

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  basePrice   Decimal  @db.Decimal(10, 2)
  // Used to quote shipping accurately (a shirt vs. 10 shirts isn't the same
  // parcel) — null falls back to a conservative default weight per unit.
  weightKg    Decimal? @db.Decimal(6, 3)
  active      Boolean  @default(true)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Wholesale (mayoreo) pricing — buying wholesaleMinQty+ units of this
  // product's variants gets wholesaleDiscountPercent off, meant for the
  // handful of higher-ticket products that actually drive bulk orders.
  wholesaleEnabled         Boolean  @default(false)
  wholesaleMinQty          Int?
  wholesaleDiscountPercent Decimal? @db.Decimal(5, 2)

  // Weekly "3 prendas en descuento" promo — a simple on/off checkbox per
  // product rather than a date range, since the owner turns it on/off by
  // hand each Monday. Shown storefront-wide as a struck-through original
  // price next to the discounted one, and auto-collected under the
  // "Descuentos" category page.
  discountEnabled Boolean  @default(false)
  discountPercent Decimal? @db.Decimal(5, 2)

  // Shown only on desktop when hovering the product card in the catalog
  // grid — never part of the regular image carousel.
  hoverImageUrl String?

  images   ProductImage[]
  variants ProductVariant[]

  @@index([categoryId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  size      String
  color     String
  colorHex  String? // hex swatch shown on the storefront instead of the color name
  colorHex2 String? // second hex swatch for two-tone variants (e.g. café/azul)
  price     Decimal? @db.Decimal(10, 2) // overrides Product.basePrice when set
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Set by the Loyverse catalog sync (matched by SKU) — lets webhook/push
  // updates address the right Loyverse variant without re-matching by SKU
  // on every call.
  loyverseVariantId String? @unique

  inventory           Inventory?
  inventoryMovements  InventoryMovement[]
  orderItems          OrderItem[]
  posSaleItems        PosSaleItem[]

  @@unique([productId, size, color])
  @@index([productId])
}

// ---------- Inventory ----------

model Inventory {
  id                String         @id @default(cuid())
  variantId         String         @unique
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int            @default(0)
  lowStockThreshold Int            @default(5)
  // Set when a low-stock alert email has been sent for the current dip
  // below threshold; cleared once restocked above it, so restocking is
  // the only thing that re-arms the alert (no repeat emails per sale).
  lowStockAlertedAt DateTime?
  updatedAt         DateTime       @updatedAt
}

enum InventoryMovementType {
  RESTOCK
  ONLINE_SALE
  POS_SALE
  ADJUSTMENT
  RETURN
  LOYVERSE_SYNC
}

model InventoryMovement {
  id         String                 @id @default(cuid())
  variantId  String
  variant    ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type       InventoryMovementType
  quantity   Int                    // positive = stock in, negative = stock out
  note       String?
  userId     String?
  user       User?                  @relation(fields: [userId], references: [id])
  orderId    String?
  order      Order?                 @relation(fields: [orderId], references: [id])
  posSaleId  String?
  posSale    PosSale?               @relation(fields: [posSaleId], references: [id])
  createdAt  DateTime               @default(now())

  @@index([variantId])
  @@index([createdAt])
}

// ---------- Online Orders / Payments ----------

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  MERCADO_PAGO
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)
  active         Boolean    @default(true)
  minOrderAmount Decimal?   @db.Decimal(10, 2)
  usageLimit     Int?
  usedCount      Int        @default(0)
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  orders Order[]
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  // Sequential, human-facing number for display (#DF-00123) — orderNumber
  // stays the internal unique id used by webhooks/logs.
  orderSeq        Int             @default(autoincrement()) @unique
  status          OrderStatus     @default(PENDING)
  customerEmail   String
  customerName    String?
  customerPhone   String?
  shippingAddress Json?
  // Customer picked "Recoger en tienda" at checkout instead of shipping —
  // shippingAddress stays null and shippingCost stays 0 for these.
  pickupInStore   Boolean         @default(false)
  subtotal        Decimal         @db.Decimal(10, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(10, 2)
  shippingCost    Decimal         @default(0) @db.Decimal(10, 2)
  total           Decimal         @db.Decimal(10, 2)
  currency        String          @default("MXN")
  paymentProvider PaymentProvider?
  paymentRef      String?
  couponId        String?
  coupon          Coupon?         @relation(fields: [couponId], references: [id])
  confirmationSentAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items               OrderItem[]
  inventoryMovements  InventoryMovement[]
  shipment            Shipment?

  @@index([status])
  @@index([createdAt])
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
}

model ShippingSettings {
  id             String   @id @default("default")
  flatRate       Decimal  @default(0) @db.Decimal(10, 2)
  freeOverAmount Decimal? @db.Decimal(10, 2)

  // Origin address for Skydropx label generation — where the package
  // actually ships from.
  originCompany String?
  originName    String?
  originStreet  String?
  originCity    String?
  originState   String?
  originZip     String?
  originPhone   String?
  originEmail   String?

  updatedAt DateTime @updatedAt
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         ShipmentStatus @default(PENDING)
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  labelUrl       String?
  cost           Decimal?       @db.Decimal(10, 2)
  notes          String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  // Pending Skydropx quote, shown to the admin as a rate picker before
  // booking a label — cleared once a rate is booked.
  skydropxQuotationId String?
  skydropxQuoteJson   Json?
  // Which rate (by id, matching one entry in skydropxQuoteJson) the
  // customer actually picked and paid for at checkout — so the admin isn't
  // stuck guessing among options the buyer never saw the price of.
  skydropxSelectedRateId String?
  // Skydropx creates a shipment asynchronously — right after booking it
  // often has no tracking number yet (workflow_status "in_progress").
  // Kept so the admin can re-check status later instead of the booking
  // attempt just failing with no way to recover it.
  skydropxShipmentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)

  @@index([orderId])
  @@index([variantId])
}

// ---------- POS (in-store, record-only) ----------

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

model PosSale {
  id        String   @id @default(cuid())
  saleNumber String  @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  total     Decimal  @db.Decimal(10, 2)
  note      String?
  createdAt DateTime @default(now())

  items               PosSaleItem[]
  payments            PosSalePayment[]
  inventoryMovements  InventoryMovement[]

  @@index([createdAt])
}

// A sale can be split across payment methods (e.g. $200 cash + $500 card),
// so amounts live on their own rows rather than a single field on PosSale.
model PosSalePayment {
  id        String        @id @default(cuid())
  posSaleId String
  posSale   PosSale       @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)

  @@index([posSaleId])
  @@index([method])
}

model PosSaleItem {
  id        String         @id @default(cuid())
  posSaleId String
  posSale   PosSale        @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)

  @@index([posSaleId])
  @@index([variantId])
}

// ---------- Customer reviews (public submission, admin-approved) ----------

model Review {
  id           String   @id @default(cuid())
  customerName String
  rating       Int // 1-5
  text         String
  photoUrl     String?
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([approved, createdAt])
}
